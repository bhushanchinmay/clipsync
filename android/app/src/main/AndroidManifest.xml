<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for TCP connection to Mac daemon -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to run a foreground service (keeps the sync alive) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 14+ requires declaring the foreground service type permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ requires runtime permission for posting notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to get Wi-Fi info for mDNS discovery -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Required for MulticastLock to receive mDNS multicast packets -->
    <!-- Android 12 and below need this for NSD/mDNS to work reliably -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".ClipSyncApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_clipboard"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipSync">

        <!-- Main UI activity - shows status and clipboard history -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Foreground service that handles mDNS discovery and TCP connection -->
        <!-- dataSync type is used for network synchronization -->
        <service
            android:name=".ClipSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
